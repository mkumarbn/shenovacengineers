# Copy to .env.local and fill in. Never commit real passwords.

# Public URL used for links and images inside emails
NEXT_PUBLIC_SITE_URL=https://shenovacengineers.vercel.app

# SMTP sender (Gmail: smtp.gmail.com / 587 / tls + a Google App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Shenovac Engineers

# Who receives website enquiries (comma-separated)
CONTACT_TO_EMAIL=info@shenovacengineers.com,shenovacpumps@yahoo.in
# Where customer replies to the confirmation email should go
CONTACT_REPLY_TO=info@shenovacengineers.com
